<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cebbank.springcloudcard.cardInfo.mapper.CardInfoMapper">
    <resultMap id="cardInfoMap" type="com.cebbank.springcloudcard.cardInfo.bo.CardBo">
        <result property="id" column="id"/>
        <result property="userName" column="user_name"/>
        <result property="mobile" column="mobile"/>
        <result property="address" column="address"/>
        <result property="theme" column="theme"/>
        <result property="addDate" column="add_date"/>
        <result property="title" column="title"/>
    </resultMap>
    <select id="getCardInfoByMobile" resultMap="cardInfoMap">
        select * from card_info where mobile = #{mobile}
    </select>
</mapper>
